# Local development only. Copy to `.env` and fill in.
# `.env` is gitignored and must never be committed or deployed.
#
# These create a single administrator in the Vite preview's throwaway in-memory
# database, because the delivered package intentionally ships with no working
# credentials (PILOT_CREDENTIALS is empty, and all 73 seeded directory entries
# are 'pending' with no password hash).
#
# Leave both unset to get the shipped behaviour: the sign-in screen with no
# account able to satisfy it.
#
# NOTE: this path seeds the password hash directly and therefore bypasses
# validatePassword(), which requires 10+ characters including upper, lower,
# digit and a special character. Anything weaker is acceptable only here, in a
# local in-memory database. Never reuse these values on a real deployment.

PREVIEW_ADMIN_EMAIL=
PREVIEW_ADMIN_PASSWORD=

# The assistant's OpenAI key, used by /api/assistant/ask. Local preview only —
# deployed environments take it from a Worker secret instead:
#   npx wrangler secret put OPENAI_API_KEY
# Leave it unset to run everything else; the assistant then answers 503 and no
# other route is affected.
OPENAI_API_KEY=

{
  "name": "sites-worker-esm-starter",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bash scripts/build.sh && vite",
    "build": "bash scripts/build.sh",
    "build:pages": "bash scripts/build-pages.sh",
    "deploy": "bash scripts/deploy-prod.sh",
    "deploy:prod": "bash scripts/deploy-prod.sh",
    "deploy:test": "bash scripts/deploy-test.sh",
    "check:prod": "bash scripts/check-deploy-target.sh prod",
    "check:test": "bash scripts/check-deploy-target.sh test",
    "db:test": "wrangler d1 execute 34dca57e-bd32-46cd-b154-8c362efaeb4c --remote",
    "db:prod": "wrangler d1 execute 94241844-c709-445f-a71c-49f8b65a7cfd --remote",
    "validate": "node scripts/validate-artifact.mjs",
    "test": "npm run build && npm run validate && node scripts/smoke-test.mjs"
  },
  "devDependencies": {
    "vite": "^7.1.4",
    "wrangler": "^4.129.0"
  }
}
